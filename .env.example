# Copy to .env for local development. In Vercel, DATABASE_URL / POSTGRES_URL
# are already set automatically by the Neon Postgres storage integration.
DATABASE_URL=postgres://user:password@localhost:5432/tenant_portal

# Secret used to sign login session cookies. Defaults to a fixed dev value
# if unset (matching how the old PORTAL_PASSWORD prototype worked) — set
# a real random value in production, e.g.: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
