# Copy to .env for local development. In Vercel, DATABASE_URL / POSTGRES_URL
# are already set automatically by the Neon Postgres storage integration.
DATABASE_URL=postgres://user:password@localhost:5432/tenant_portal

# Passcode the login screen (and the API behind it) checks against.
# Defaults to "triangle" if unset, matching the original prototype.
PORTAL_PASSWORD=triangle
